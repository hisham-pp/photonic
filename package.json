{
  "name": "photonic",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/desktop",
    "dev:web": "npm run dev --workspace=apps/website",
    "dev:all": "npm run dev --workspace=apps/desktop & npm run dev --workspace=apps/website",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}